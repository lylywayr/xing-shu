# 星枢公开部署环境模板
# 复制为 .env 后填写；.env 永远不要提交到 Git。

# 镜像、容器、端口和唯一持久化目录
STARCORE_IMAGE=xing-shu:latest
STARCORE_CONTAINER_NAME=xing-shu
STARCORE_PORT=12100
STARCORE_DATA_PATH=./data
# 可按部署网络覆盖，例如使用可信的 Go 模块镜像。
GOPROXY=https://proxy.golang.org,direct

# 星枢管理员认证：至少设置 ADMIN_API_KEY，生产环境请使用随机长值。
ADMIN_API_KEY=
STARCORE_ADMIN_USER=
STARCORE_ADMIN_PASSWORD=

# 星枢自身
STARCORE_NATIVE_CHAT=true
STARCORE_DATA_DIR=/data
LISTEN=:12100

# 可选 FreeLLMAPI 外部集成；只有明确授权后才读取/调用。
FREELLMAPI_URL=
FREELLMAPI_KEY=
FREELLMAPI_DB_PATH=

# 通用 OpenAI-compatible Provider。每组都必须同时配置 URL 和 Key。
PROVIDER_A_URL=
PROVIDER_A_KEY=
PROVIDER_B_URL=
PROVIDER_B_KEY=
PROVIDER_C_URL=
PROVIDER_C_KEY=

# 兼容既有部署命名的标准协议槽位；没有内置地址或平台行为。
WORKBUDDY_URL=
WORKBUDDY_KEY=
TRAE_URL=
TRAE_KEY=
QODER_URL=
QODER_KEY=
CCTQ_URL=
CCTQ_KEY=
